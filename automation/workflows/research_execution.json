{
  "name": "MarketLab AI — Authenticated Research Execution",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-research",
        "options": {}
      },
      "id": "1",
      "name": "Incoming Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/research",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-API-Key",
              "value": "={{$env.API_KEY || 'marketlab-test-key'}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"question\": \"{{$json.body.question || 'Research Orient Green Power for a six-month horizon'}}\",\n  \"horizon_days\": {{$json.body.horizon_days || 180}}\n}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "2",
      "name": "Queue Research Run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/internal/automation-events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{$env.INTERNAL_AUTOMATION_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"workflow_name\": \"research_execution\",\n  \"run_id\": \"{{$json.run_id}}\",\n  \"status\": \"queued\"\n}"
      },
      "id": "3",
      "name": "Log Queue Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Incoming Webhook": {
      "main": [
        [
          {
            "node": "Queue Research Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Queue Research Run": {
      "main": [
        [
          {
            "node": "Log Queue Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {}
}
