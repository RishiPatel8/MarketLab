{
  "name": "MarketLab AI — Daily Market Data Ingestion",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 11 * * 1-5"
            }
          ]
        }
      },
      "id": "1",
      "name": "Cron Daily 16:30 IST",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/internal/ingestion-jobs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{$env.INTERNAL_AUTOMATION_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"symbol\": \"GREENPOWER\",\n  \"exchange\": \"NSE\",\n  \"source\": \"nse_bhavcopy_daily\"\n}",
        "options": {
          "timeout": 30000,
          "retry": {
            "maxTries": 3,
            "waitBetweenTries": 5000
          }
        }
      },
      "id": "2",
      "name": "Trigger Ingestion Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/internal/automation-events",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Token",
              "value": "={{$env.INTERNAL_AUTOMATION_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"workflow_name\": \"market_data_ingestion\",\n  \"status\": \"succeeded\",\n  \"timestamp\": \"={{new Date().toISOString()}}\"\n}"
      },
      "id": "3",
      "name": "Log Success Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Cron Daily 16:30 IST": {
      "main": [
        [
          {
            "node": "Trigger Ingestion Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Ingestion Job": {
      "main": [
        [
          {
            "node": "Log Success Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {}
}
