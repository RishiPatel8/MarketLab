# ==============================================================================
# MarketLab AI — Environment Configuration
# ==============================================================================

# Application
APP_NAME=MarketLab AI
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=marketlab-dev-secret-key-change-in-production-min32chars

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database (PostgreSQL + pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=marketlab
POSTGRES_PASSWORD=marketlab_secret
POSTGRES_DB=marketlab_db
DATABASE_URL=postgresql+psycopg://marketlab:marketlab_secret@localhost:5432/marketlab_db
# For SQLite test fallback:
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./marketlab_test.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Configure at least one for live LLM mode, or use mock mode)
LLM_PROVIDER=mock
# Options: mock, openai, gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings
EMBEDDING_PROVIDER=mock
# Options: mock, openai, gemini, huggingface
EMBEDDING_MODEL=text-embedding-3-small

# Market Data
MARKET_DATA_PROVIDER=fixture
# Options: fixture, nse_bse

# Authentication & Security
API_KEY_ENABLED=false
API_KEY=marketlab-test-key
INTERNAL_AUTOMATION_TOKEN=marketlab-internal-automation-token-secure

# Worker & Background Tasks
RESEARCH_TIMEOUT_SECONDS=300
MAX_AGENT_RETRIES=2
