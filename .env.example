# ==============================================================================
# MarketLab AI — Environment Configuration
# ==============================================================================

# Application
APP_NAME=MarketLab AI
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=marketlab-dev-secret-key-change-in-production-min32chars

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database (PostgreSQL + pgvector or SQLite)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=marketlab
POSTGRES_PASSWORD=marketlab_secret
POSTGRES_DB=marketlab_db
DATABASE_URL=postgresql+psycopg://marketlab:marketlab_secret@localhost:5432/marketlab_db
# For SQLite test fallback:
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./marketlab.db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Provider Configuration (Live vs Mock)
# ==============================================================================

# Market Data Provider
# Options:
#   - yfinance: Live historical/delayed daily bars for Indian Equities (GREENPOWER.NS, RELIANCE.NS, etc.)
#   - fixture: Deterministic audited offline bars for testing
#   - nse_bse: Direct exchange gateway (requires licensed credentials)
MARKET_DATA_PROVIDER=fixture

# LLM Provider
# Options:
#   - mock: Deterministic offline LLM responses
#   - groq: Groq ultra-fast LPU inference (qwen/qwen3.8-27b, openai/gpt-oss-120b)
#   - gemini: Google Gemini (gemini-2.5-flash) via official google-genai SDK
#   - openai: OpenAI (gpt-4o-mini)
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding Provider
# Options:
#   - mock: Deterministic 1536-dim character trigram unit vectors (offline)
#   - gemini: Google official embeddings (text-embedding-004, 768 dimensions)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=1536

# Live Integration Test Flag (Gating real provider calls during testing)
# Set to 'true' in PowerShell: $env:RUN_LIVE_INTEGRATION_TESTS="true"
RUN_LIVE_INTEGRATION_TESTS=false

# Authentication & Security
API_KEY_ENABLED=false
API_KEY=marketlab-test-key
INTERNAL_AUTOMATION_TOKEN=marketlab-internal-automation-token-secure

# Worker & Background Tasks
RESEARCH_TIMEOUT_SECONDS=300
MAX_AGENT_RETRIES=2
